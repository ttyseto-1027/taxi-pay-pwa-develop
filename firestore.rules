rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled != false;
    }

    // 管理者登録は本人が自分の登録有無を確認可能。変更は管理者のみ。
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /betaAllowlist/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow read, write: if isAdmin();
    }

    // 本人は自分の情報のみ。管理者はユーザー管理のため全利用者を閲覧可能。
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 端末情報・ログイン履歴は本人が記録し、管理者だけが他利用者分を閲覧可能。
    match /users/{uid}/devices/{deviceId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/loginHistory/{historyId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if signedIn() && request.auth.uid == uid;
    }

    match /accessCodes/{id} {
      allow read, write: if isAdmin();
    }

    match /v13LoginSuccess/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /appSettings/systemAnnouncement {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    match /appSettings/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id != 'systemAnnouncement';
    }

    // 上記以外は明示的に拒否。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
